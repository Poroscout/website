---
import { Image } from "astro:assets";
import PoroScoutLogo from "../assets/logo.webp";
import { twMerge } from "tailwind-merge";
import Button from "../components/Button.astro";
import SearchPalette from "./SearchPalette.astro";

type NavbarItem = {
  href: string;
  label: string;
};

const navbarItems = [
  // { href: "/ranked", label: "Ranked" }, // WIP: restore when ranked tracking is ready.
  { href: "/about", label: "About" },
  { href: "/docs", label: "Wiki" },
  { href: "/news", label: "News" },
] satisfies NavbarItem[];

export interface Props {
  forceBackground?: boolean;
  class?: string;
  sticky?: boolean;
}

const props = {
  forceBackground: false,
  sticky: true,
  ...Astro.props,
} satisfies Props;
---

<div
  class={twMerge(
    "z-50 text-gold-1 transition-[background-color,border-color,backdrop-filter] duration-200 font-subhead text-xs border-b border-transparent" +
      (props.forceBackground
        ? " bg-void-0/95 backdrop-blur-lg"
        : " bg-transparent"),
    props.sticky && "top-0 left-0 right-0 fixed",
    props.class,
  )}
  id="navbar"
  data-disable-script={props.forceBackground ? "true" : "false"}
>
  <nav
    aria-label="Main navigation"
    class="max-w-6xl mx-auto flex flex-row justify-between items-center px-6 sm:px-8 py-4 gap-6"
  >
    <ul class="flex flex-row items-center gap-8">
      <li>
        <a href="/" aria-label="PoroScout Home" class="flex items-center gap-2.5">
          <Image
            src={PoroScoutLogo}
            alt=""
            width={40}
            height={40}
            class="h-10 w-10"
          />
          <span class="font-display text-xl font-bold">PoroScout</span>
        </a>
      </li>

      {
        navbarItems.map((item) => (
          <li class="hidden md:block">
            <a
              href={item.href}
              aria-current={Astro.url.pathname === item.href || Astro.url.pathname.startsWith(`${item.href}/`) ? "page" : undefined}
              class="group relative inline-block py-1 transition-colors duration-200 [text-shadow:0_1px_4px_rgb(0_0_0/0.6)] hover:text-hex-teal"
              data-astro-prefetch
            >
              {item.label}
              <span
                aria-hidden="true"
                class="absolute -bottom-0.5 left-0 h-0.5 w-full origin-left scale-x-0 bg-hex-teal transition-transform duration-300 ease-out group-hover:scale-x-100"
              />
            </a>
          </li>
        ))
      }
    </ul>

    <!-- desktop: search bar (opens command palette) + add button -->
    <div class="hidden md:flex items-center gap-4">
      <button
        type="button"
        data-search-trigger
        aria-label="Search Wiki"
        class="group relative flex min-h-11 items-center gap-2 rounded-md border border-gold-2/25 bg-void-0/40 py-2 pr-3 pl-10 text-left text-gold-1/80 transition-colors hover:border-gold-2/60 hover:text-gold-1"
      >
        <svg
          class="absolute left-3 pointer-events-none"
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 256 256"
          ><g fill="currentColor"
            ><path
              d="M192 112a80 80 0 1 1-80-80a80 80 0 0 1 80 80"
              opacity="0.2"></path><path
              d="m229.66 218.34l-50.06-50.06a88.21 88.21 0 1 0-11.32 11.31l50.06 50.07a8 8 0 0 0 11.32-11.32M40 112a72 72 0 1 1 72 72a72.08 72.08 0 0 1-72-72"
            ></path></g
          ></svg
        >
        <span class="hidden lg:inline">Search Wiki</span>
        <kbd
          class="ml-2 hidden shrink-0 rounded border border-gold-2/25 px-1.5 py-0.5 font-mono text-[0.65rem] text-gold-1/70 lg:inline-block"
          >Ctrl K</kbd
        >
      </button>

      <!-- add button -->
      <Button class="px-4 py-2 text-xs" href="/invite">
        Add PoroScout
      </Button>
    </div>

    <!-- mobile: hamburger toggle -->
    <button
      type="button"
      id="mobile-menu-toggle"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="md:hidden flex min-h-11 min-w-11 items-center justify-center rounded-md border border-gold-2/30 bg-void-0/50 p-2 text-gold-1 transition-colors hover:border-gold-2"
    >
      <svg
        class="block"
        data-icon-open
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 256 256"
        fill="currentColor"
        ><path
          d="M224 128a8 8 0 0 1-8 8H40a8 8 0 0 1 0-16h176a8 8 0 0 1 8 8M40 72h176a8 8 0 0 0 0-16H40a8 8 0 0 0 0 16m176 112H40a8 8 0 0 0 0 16h176a8 8 0 0 0 0-16"
        ></path></svg
      >
      <svg
        class="hidden"
        data-icon-close
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 256 256"
        fill="currentColor"
        ><path
          d="M205.66 194.34a8 8 0 0 1-11.32 11.32L128 139.31l-66.34 66.35a8 8 0 0 1-11.32-11.32L116.69 128L50.34 61.66a8 8 0 0 1 11.32-11.32L128 116.69l66.34-66.35a8 8 0 0 1 11.32 11.32L139.31 128Z"
        ></path></svg
      >
    </button>
  </nav>

  <!-- mobile menu panel -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-gold-2/20 bg-void-0/95 backdrop-blur-lg"
  >
    <ul class="flex flex-col gap-1 p-4">
      {
        navbarItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={Astro.url.pathname === item.href || Astro.url.pathname.startsWith(`${item.href}/`) ? "page" : undefined}
              class="flex min-h-11 items-center rounded-md px-3 py-2 transition-colors duration-200 hover:bg-hex-teal/10 hover:text-hex-teal"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex flex-col gap-3 p-4 pt-0">
      <button
        type="button"
        data-search-trigger
        class="group relative flex min-h-11 items-center gap-3 rounded-md border border-gold-2/25 bg-void-1 py-3 pr-3 pl-12 text-left text-gold-1 transition-colors hover:border-gold-2"
      >
        <svg
          class="absolute left-4 pointer-events-none"
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 256 256"
          fill="currentColor"
          ><path
            d="m229.66 218.34l-50.06-50.06a88.21 88.21 0 1 0-11.32 11.31l50.06 50.07a8 8 0 0 0 11.32-11.32M40 112a72 72 0 1 1 72 72a72.08 72.08 0 0 1-72-72"
          ></path></svg
        >
        <span>Search Wiki</span>
      </button>

      <Button class="w-full" href="/invite">
        Add PoroScout
      </Button>
    </div>
  </div>
</div>

<SearchPalette />

<script>
  // On scroll, change from transparent to solid background
  const navbar = document.getElementById("navbar");
  const menuToggle = document.getElementById("mobile-menu-toggle");

  const SCROLL_ACTIVE_CLASSES = [
    "bg-void-0/95",
    "backdrop-blur-lg",
    "border-b-card-border/[0.22]",
  ];

  const SCROLL_INACTIVE_CLASSES = ["bg-transparent", "border-transparent"];

  if (navbar && navbar.dataset.disableScript !== "true") {
    window.addEventListener("scroll", updateNavbarBackground, { passive: true });
    updateNavbarBackground();
  }

  function updateNavbarBackground() {
    if (!navbar) return;

    if (window.scrollY > 16 || menuToggle?.getAttribute("aria-expanded") === "true") {
      navbar.classList.add(...SCROLL_ACTIVE_CLASSES);
      navbar.classList.remove(...SCROLL_INACTIVE_CLASSES);
    } else {
      navbar.classList.remove(...SCROLL_ACTIVE_CLASSES);
      navbar.classList.add(...SCROLL_INACTIVE_CLASSES);
    }
  }

  // Open the command palette from the navbar trigger(s).
  const triggers = document.querySelectorAll("[data-search-trigger]");
  triggers.forEach((trigger) =>
    trigger.addEventListener("click", () => {
      window.openSearchPalette?.();
      closeMobileMenu();
    }),
  );

  // Mobile menu toggle
  const mobileMenu = document.getElementById("mobile-menu");
  const iconOpen = menuToggle?.querySelector("[data-icon-open]");
  const iconClose = menuToggle?.querySelector("[data-icon-close]");

  function closeMobileMenu() {
    mobileMenu?.classList.add("hidden");
    menuToggle?.setAttribute("aria-expanded", "false");
    iconOpen?.classList.remove("hidden");
    iconClose?.classList.add("hidden");
    if (navbar?.dataset.disableScript !== "true") updateNavbarBackground();
  }

  menuToggle?.addEventListener("click", () => {
    const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
    if (isOpen) {
      closeMobileMenu();
    } else {
      mobileMenu?.classList.remove("hidden");
      menuToggle.setAttribute("aria-expanded", "true");
      iconOpen?.classList.add("hidden");
      iconClose?.classList.remove("hidden");
      if (navbar?.dataset.disableScript !== "true") updateNavbarBackground();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menuToggle?.getAttribute("aria-expanded") === "true") {
      closeMobileMenu();
      menuToggle.focus();
    }
  });

  // Close menu when resizing up to desktop
  window.addEventListener("resize", () => {
    if (window.innerWidth >= 768) closeMobileMenu();
  });
</script>
