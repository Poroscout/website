---
import { Image } from "astro:assets";
import PoroScoutLogo from "../assets/logo.webp";
import { twMerge } from "tailwind-merge";
import Button from "../components/Button.astro";
import SearchPalette from "./SearchPalette.astro";

type NavbarItem = {
  href: string;
  label: string;
};

const navbarItems = [
  { href: "/about", label: "About" },
  { href: "/docs", label: "Wiki" },
  { href: "/news", label: "News" },
] satisfies NavbarItem[];

export interface Props {
  forceBackground?: boolean;
  class?: string;
  sticky?: boolean;
}

const props = {
  forceBackground: false,
  sticky: true,
  ...Astro.props,
} satisfies Props;
---

<div
  class={twMerge(
    "text-primary transition-all duration-700 font-body border-b border-transparent" +
      (props.forceBackground
        ? " bg-gray-950/40 backdrop-blur-lg"
        : " bg-transparent"),
    props.sticky && "top-0 left-0 right-0 fixed",
    props.class,
  )}
  id="navbar"
  data-disable-script={props.forceBackground ? "true" : "false"}
>
  <nav
    class="max-w-7xl mx-auto flex flex-row justify-between items-center p-4 gap-8"
  >
    <ul class="flex flex-row justify-between items-center max-w-xl grow gap-6">
      <li>
        <a href="/">
          <span class="sr-only">PoroScout Home</span>
          <Image
            src={PoroScoutLogo}
            alt="PoroScout Logo"
            width={40}
            height={40}
            class="h-10 w-10"
          />
        </a>
      </li>

      {
        navbarItems.map((item) => (
          <li class="hidden md:block">
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>

    <!-- desktop: search bar (opens command palette) + add button -->
    <div class="hidden md:flex items-center gap-4">
      <button
        type="button"
        data-search-trigger
        class="group relative flex items-center gap-3 rounded-lg border border-gray-700/60 bg-gray-400/20 py-4 pr-3 pl-14 text-left text-gray-400 transition-colors hover:border-gray-600 hover:text-gray-300"
      >
        <svg
          class="absolute left-6 pointer-events-none"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 256 256"
          ><g fill="currentColor"
            ><path
              d="M192 112a80 80 0 1 1-80-80a80 80 0 0 1 80 80"
              opacity="0.2"></path><path
              d="m229.66 218.34l-50.06-50.06a88.21 88.21 0 1 0-11.32 11.31l50.06 50.07a8 8 0 0 0 11.32-11.32M40 112a72 72 0 1 1 72 72a72.08 72.08 0 0 1-72-72"
            ></path></g
          ></svg
        >
        <span class="hidden sm:inline">Search Wiki</span>
        <kbd
          class="ml-2 hidden shrink-0 rounded border border-gray-600 px-1.5 py-0.5 font-mono text-xs text-gray-400 sm:inline-block"
          >Ctrl K</kbd
        >
      </button>

      <!-- add button -->
      <Button class="h-full" variant="teal" href="/invite">
        Add Poroscout
      </Button>
    </div>

    <!-- mobile: hamburger toggle -->
    <button
      type="button"
      id="mobile-menu-toggle"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="md:hidden flex items-center justify-center rounded-lg border border-gray-700/60 bg-gray-400/20 p-2 text-gray-300 transition-colors hover:border-gray-600"
    >
      <svg
        class="block"
        data-icon-open
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 256 256"
        fill="currentColor"
        ><path
          d="M224 128a8 8 0 0 1-8 8H40a8 8 0 0 1 0-16h176a8 8 0 0 1 8 8M40 72h176a8 8 0 0 0 0-16H40a8 8 0 0 0 0 16m176 112H40a8 8 0 0 0 0 16h176a8 8 0 0 0 0-16"
        ></path></svg
      >
      <svg
        class="hidden"
        data-icon-close
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 256 256"
        fill="currentColor"
        ><path
          d="M205.66 194.34a8 8 0 0 1-11.32 11.32L128 139.31l-66.34 66.35a8 8 0 0 1-11.32-11.32L116.69 128L50.34 61.66a8 8 0 0 1 11.32-11.32L128 116.69l66.34-66.35a8 8 0 0 1 11.32 11.32L139.31 128Z"
        ></path></svg
      >
    </button>
  </nav>

  <!-- mobile menu panel -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-gray-700/40 bg-gray-950/60 backdrop-blur-lg"
  >
    <ul class="flex flex-col gap-1 p-4">
      {
        navbarItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="block rounded-lg px-3 py-2 transition-colors hover:bg-gray-400/10"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex flex-col gap-3 p-4 pt-0">
      <button
        type="button"
        data-search-trigger
        class="group relative flex items-center gap-3 rounded-lg border border-gray-700/60 bg-gray-400/20 py-3 pr-3 pl-12 text-left text-gray-400 transition-colors hover:border-gray-600 hover:text-gray-300"
      >
        <svg
          class="absolute left-4 pointer-events-none"
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 256 256"
          fill="currentColor"
          ><path
            d="m229.66 218.34l-50.06-50.06a88.21 88.21 0 1 0-11.32 11.31l50.06 50.07a8 8 0 0 0 11.32-11.32M40 112a72 72 0 1 1 72 72a72.08 72.08 0 0 1-72-72"
          ></path></svg
        >
        <span>Search Wiki</span>
      </button>

      <Button class="w-full" variant="teal" href="/invite">
        Add Poroscout
      </Button>
    </div>
  </div>
</div>

<SearchPalette />

<!-- so tailwind compiler picks up on the classes -->
<!-- <div class="bg-gray-950/40 backdrop-blur-lg border-b-card-border/[0.22]"></div> -->

<script>
  // On scroll, change from transparent to solid background
  const navbar = document.getElementById("navbar");

  const SCROLL_ACTIVE_CLASSES = [
    "bg-gray-950/40",
    "backdrop-blur-lg",
    "border-b-card-border/[0.22]",
  ];

  const SCROLL_INACTIVE_CLASSES = ["bg-transparent", "border-transparent"];

  if (navbar && navbar.dataset.disableScript !== "true") {
    window.addEventListener("scroll", updateNavbarBackground);
    updateNavbarBackground();
  }

  function updateNavbarBackground() {
    if (!navbar) return;

    if (window.scrollY > 0 || navbar.dataset.forceBackground === "true") {
      navbar.classList.add(...SCROLL_ACTIVE_CLASSES);
      navbar.classList.remove(...SCROLL_INACTIVE_CLASSES);
    } else {
      navbar.classList.remove(...SCROLL_ACTIVE_CLASSES);
      navbar.classList.add(...SCROLL_INACTIVE_CLASSES);
    }
  }

  // Open the command palette from the navbar trigger(s).
  const triggers = document.querySelectorAll("[data-search-trigger]");
  triggers.forEach((trigger) =>
    trigger.addEventListener("click", () => {
      (window as any).openSearchPalette?.();
      closeMobileMenu();
    }),
  );

  // Mobile menu toggle
  const menuToggle = document.getElementById("mobile-menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const iconOpen = menuToggle?.querySelector("[data-icon-open]");
  const iconClose = menuToggle?.querySelector("[data-icon-close]");

  function closeMobileMenu() {
    mobileMenu?.classList.add("hidden");
    menuToggle?.setAttribute("aria-expanded", "false");
    iconOpen?.classList.remove("hidden");
    iconClose?.classList.add("hidden");
  }

  menuToggle?.addEventListener("click", () => {
    const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
    if (isOpen) {
      closeMobileMenu();
    } else {
      mobileMenu?.classList.remove("hidden");
      menuToggle.setAttribute("aria-expanded", "true");
      iconOpen?.classList.add("hidden");
      iconClose?.classList.remove("hidden");
    }
  });

  // Close menu when resizing up to desktop
  window.addEventListener("resize", () => {
    if (window.innerWidth >= 768) closeMobileMenu();
  });
</script>
