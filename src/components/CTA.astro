---
import { getCollection } from "astro:content";
import Eyebrow from "./Eyebrow.astro";
import { Icon } from "astro-icon/components";

const inviteGuildUrl = "/invite";
const inviteUserUrl = "/invite-user";
const supportServerUrl = "/discord";

// Background grid: every documented command, pulled from the docs collection.
const commands = (await getCollection("docs"))
  .filter((d) => d.data.category === "Commands")
  .sort((a, b) => a.data.order - b.data.order);

// Repeat so the grid always fills the section behind the card.
const bgCards = [...commands, ...commands, ...commands];

const optBtnBase =
  "mt-3 inline-flex min-h-11 w-full items-center justify-center font-display uppercase tracking-[0.06em] text-[0.85rem] px-4 py-3 border rounded-md transition-colors duration-200";
---

<section
  class="relative overflow-hidden bg-linear-to-b from-hex-blue-deep to-void-0"
>
  <!-- subtle background grid of every command -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 select-none px-6 pt-8 pb-40 opacity-20"
  >
    <div
      class="mx-auto grid max-w-7xl grid-cols-[repeat(auto-fill,minmax(220px,1fr))] gap-3"
    >
      {
        bgCards.map((c) => (
          <div class="rounded-lg border border-gold-3/15 bg-card-bottom/40 p-4">
            <code class="font-subhead text-[0.95rem] font-semibold text-hex-teal">
              {c.data.title}
            </code>
            <p class="mt-1.5 line-clamp-2 text-[0.82rem] text-grey-1/80">
              {c.data.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>

  <!-- radial darken: fades the background cards toward the centered card -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_95%_80%_at_50%_42%,color-mix(in_srgb,var(--color-void-0)_88%,transparent)_0%,transparent_60%)]"
  >
  </div>

  <!-- foreground card -->
  <div class="relative mx-auto max-w-6xl px-6 sm:px-8 py-16 md:py-20">
    <div
      data-reveal
      class="relative overflow-hidden rounded-xl border border-gold-2/25 bg-linear-to-b from-card-top to-card-bottom px-6 py-10 sm:p-12 md:p-16 text-center"
    >
      <!-- teal glow -->
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -top-[300px] left-1/2 h-[600px] w-[600px] -translate-x-1/2 rounded-full bg-[radial-gradient(circle,rgba(10,200,185,0.25),transparent_65%)] blur-[40px]"
      >
      </div>

      <div class="flex flex-row justify-center">
        <Eyebrow>Ready up</Eyebrow>
      </div>
      <h2 class="relative mt-3 mb-4 font-display font-bold leading-tight text-[clamp(2rem,5vw,3rem)] text-gold-1">
        Add PoroScout in seconds.
      </h2>
      <p class="relative mx-auto mb-0 max-w-xl text-sm sm:text-base leading-relaxed text-grey-1">
        Invite the bot to your server for the whole squad, or add it straight to
        your account and use it in any DM or server. No setup required, just
        type <code class="text-hex-teal">/</code> and scout.
      </p>

      <div class="relative mx-auto my-8 grid max-w-3xl gap-5 text-left sm:grid-cols-2">
        <a
          href={inviteGuildUrl}
          target="_blank"
          rel="noopener"
          class="group grid grid-rows-[auto_auto_1fr_auto] gap-2 rounded-lg border border-gold-3/20 bg-void-1/55 p-5 sm:p-6 transition-[border-color,background-color] duration-200 hover:border-gold-2 hover:bg-hex-blue/50"
        >
          <Icon name="lucide:server" size={24} class="mb-2 text-gold-2" aria-hidden="true" />
          <span class="font-display text-xl text-gold-1">Add to a Server</span>
          <span class="text-sm leading-relaxed text-grey-1">
            For your whole community. Allows all users in your server to access
            PoroScout.
          </span>
          <span
            class={`${optBtnBase} bg-gold-2 text-void-0 border-gold-3 group-hover:bg-gold-1`}
          >
            Invite to Server
          </span>
        </a>

        <a
          href={inviteUserUrl}
          target="_blank"
          rel="noopener"
          class="group grid grid-rows-[auto_auto_1fr_auto] gap-2 rounded-lg border border-gold-3/20 bg-void-1/55 p-5 sm:p-6 transition-[border-color,background-color] duration-200 hover:border-gold-2 hover:bg-hex-blue/50"
        >
          <Icon name="lucide:user-round" size={24} class="mb-2 text-gold-2" aria-hidden="true" />
          <span class="font-display text-xl text-gold-1"
            >Add to Your Account</span
          >
          <span class="text-sm leading-relaxed text-grey-1">
            Use PoroScout anywhere: DMs, group chats, any server.
          </span>
          <span
            class={`${optBtnBase} bg-transparent text-gold-1 border-gold-2/60 group-hover:border-gold-2 group-hover:bg-void-1`}
          >
            Add to Me
          </span>
        </a>
      </div>

      <p class="relative text-[0.95rem] text-grey-1">
        Questions? Join the
        <a
          href={supportServerUrl}
          target="_blank"
          rel="noopener"
          class="text-gold-2 underline-offset-2 transition-colors hover:text-hex-teal hover:underline"
        >
          support server
        </a>.
      </p>
    </div>
  </div>
</section>
