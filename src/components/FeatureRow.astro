---
import Eyebrow from "./Eyebrow.astro";
import { Image } from "astro:assets";

interface Props {
  id?: string;
  commands: string[];
  eyebrow: string;
  title: string;
  body: string;
  bullets?: string[];
  image: ImageMetadata;
  imageAlt: string;
  reverse?: boolean;
  wikiSlug?: string;
}

const {
  id,
  commands,
  eyebrow,
  title,
  body,
  bullets = [],
  image,
  imageAlt,
  reverse = false,
  wikiSlug,
} = Astro.props;
---

<div
  id={id}
  data-reveal
  class="grid grid-cols-1 md:grid-cols-2 items-center gap-10 md:gap-16 py-14 md:py-20"
>
  <div class:list={["min-w-0", reverse && "md:order-2"]}>
    <div class="flex flex-wrap gap-2 mb-6">
      {
        commands.map((c) => (
          <code class="rounded-md border border-hex-teal/25 bg-hex-teal/5 px-2.5 py-1 font-mono text-xs text-hex-teal">
            {c}
          </code>
        ))
      }
    </div>

    <Eyebrow class="mb-3">{eyebrow}</Eyebrow>

    <h2 class="mt-0 mb-4 font-display font-bold text-gold-1 text-3xl md:text-4xl leading-tight text-balance">{title}</h2>
    <p class="mt-0 mb-5 text-[0.95rem] leading-[1.8] text-grey-1">{body}</p>
    {
      bullets.length > 0 && (
        <ul class="grid list-none gap-[0.55rem] mt-0 mb-6 p-0">
          {bullets.map((b) => (
            <li class="relative pl-5 text-sm leading-relaxed text-gold-1 before:absolute before:left-0 before:top-[0.05em] before:text-[0.65em] before:text-gold-2 before:content-['◆']">
              {b}
            </li>
          ))}
        </ul>
      )
    }
    {
      wikiSlug && (
        <a
          class="group inline-flex items-center gap-[0.4rem] font-display tracking-[0.04em] text-gold-2 hover:text-hex-teal"
          href={`/docs/${wikiSlug}`}
          data-astro-prefetch
        >
          Read the docs
          <span
            class="transition-transform duration-150 ease-[ease] group-hover:translate-x-1"
            aria-hidden="true"
          >
            →
          </span>
        </a>
      )
    }
  </div>

  <div class="feature-visual min-w-0" data-feature-visual>
    <Image src={image} alt={imageAlt} fit="contain" class="w-full h-auto" widths={[400, 600, 900]} sizes="(min-width: 1152px) 512px, (min-width: 768px) 45vw, calc(100vw - 48px)" />
  </div>
</div>

<style>
  /* JavaScript prepares only offscreen artwork; the default stays visible. */
  .feature-visual[data-reveal-state="pending"] :global(img) {
    opacity: 0;
    transform: translateY(16px);
  }

  .feature-visual[data-reveal-state="revealed"] :global(img) {
    transition:
      opacity 600ms ease-out,
      transform 600ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-visual[data-reveal-state] :global(img) {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
