---
import type { ImageMetadata } from "astro";
import { twMerge } from "tailwind-merge";
import { Image } from "astro:assets";

export interface Props {
  image: string | ImageMetadata;
  title: string;
  subtitle?: string;
  class?: string;
  tooltip?: string;

  imageDimensions?: {
    width: number;
    height: number;
  };
}

const props = {
  imageDimensions: {
    width: 512,
    height: 320,
  },

  ...Astro.props,
} satisfies Props;
---

<div
  class={twMerge(
    "group relative isolate overflow-hidden rounded-lg max-w-lg max-h-80 hover:-translate-y-1 focus-within:-translate-y-1 transition-[transform,border-color] duration-200 border-card-border/35 hover:border-gold-2/70 focus-within:border-gold-2 border",
    props.class,
  )}
>
  <Image
    src={props.image}
    width={props.imageDimensions.width}
    height={props.imageDimensions.height}
    alt={props.title}
    class="rounded-lg w-full h-full object-cover"
  />

  <!-- text at bottom -->
  <div
    class="absolute inset-0 bg-gradient-to-b from-void-0/10 to-void-0/95 p-5 flex flex-col justify-end pointer-events-none"
  >
    <div>
      <h2 class="font-display text-2xl font-bold text-gold-1 leading-tight">
        {props.title}
      </h2>

      {
        props.subtitle && (
          <p class="text-gold-1/85 text-sm leading-relaxed mt-2">{props.subtitle}</p>
        )
      }
    </div>
  </div>

  <!-- tooltip fly in on hover from top -->
  {
    props.tooltip && (
      <div class="absolute top-4 opacity-0 left-5 right-5 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity duration-200">
        <p class="text-gold-1 text-xs">{props.tooltip}</p>
      </div>
    )
  }

  <slot />
</div>
