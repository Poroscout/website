---
import BlurImage from "./BlurImage.astro";
import type { ImageMetadata } from "astro";

export interface Props {
  image: string | ImageMetadata;
}

const props = Astro.props;
---

<div class="relative bg-cover bg-center bg-no-repeat">
  {/* overlay with grid */}
  <div
    class={`absolute inset-0 bg-repeat bg-[unset] bg-blend-screen`}
    style={{
      backgroundImage:
        "url(\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32' width='32' height='32' fill='none' stroke='rgb(148 163 184 / 0.2)'><path d='M0 .5H31.5V32'/></svg>\");",
    }}
  >
    {/* gradient overlay */}
    <div
      class="w-screen h-full bg-opacity-50 bg-gradient-to-b from-transparent to-gray-950 py-64"
    >
      {/* content (centered) */}
      <div class="flex justify-center items-center">
        <slot />
      </div>
    </div>
  </div>

  <BlurImage
    src={props.image as ImageMetadata}
    alt="Background image"
    priority
    class="w-full max-h-[35rem] inset-0 object-cover"
  />
</div>
