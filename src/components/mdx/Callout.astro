---
export interface Props {
  type?: "info" | "warning" | "danger";
}

const { type = "info" } = Astro.props;

const styles = {
  info: {
    border: "border-hex-teal/50",
    bg: "bg-hex-teal/[0.07]",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 256 256" fill="currentColor" class="text-hex-teal shrink-0 mt-0.5" aria-hidden="true"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm16-40a8,8,0,0,1-8,8,16,16,0,0,1-16-16V128a8,8,0,0,1,0-16,16,16,0,0,1,16,16v40A8,8,0,0,1,144,176ZM112,84a16,16,0,1,1,16,16A16,16,0,0,1,112,84Z"/></svg>`,
    text: "text-hex-teal",
  },
  warning: {
    border: "border-yellow-400/50",
    bg: "bg-yellow-400/[0.06]",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 256 256" fill="currentColor" class="text-yellow-400 shrink-0 mt-0.5" aria-hidden="true"><path d="M236.8,188.09,149.35,36.22a24.76,24.76,0,0,0-42.7,0L19.2,188.09a23.51,23.51,0,0,0,0,23.72A24.35,24.35,0,0,0,40.55,224h174.9a24.35,24.35,0,0,0,21.33-12.19A23.51,23.51,0,0,0,236.8,188.09ZM120,104a8,8,0,0,1,16,0v40a8,8,0,0,1-16,0Zm8,88a12,12,0,1,1,12-12A12,12,0,0,1,128,192Z"/></svg>`,
    text: "text-yellow-400",
  },
  danger: {
    border: "border-red-500/50",
    bg: "bg-red-500/[0.06]",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 256 256" fill="currentColor" class="text-red-400 shrink-0 mt-0.5" aria-hidden="true"><path d="M236.8,188.09,149.35,36.22a24.76,24.76,0,0,0-42.7,0L19.2,188.09a23.51,23.51,0,0,0,0,23.72A24.35,24.35,0,0,0,40.55,224h174.9a24.35,24.35,0,0,0,21.33-12.19A23.51,23.51,0,0,0,236.8,188.09ZM120,104a8,8,0,0,1,16,0v40a8,8,0,0,1-16,0Zm8,88a12,12,0,1,1,12-12A12,12,0,0,1,128,192Z"/></svg>`,
    text: "text-red-400",
  },
};

const s = styles[type];
---

<div
  class:list={[
    "flex gap-3 rounded-r border-l-2 px-4 py-3 my-5 text-[0.95rem]",
    s.border,
    s.bg,
  ]}
>
  <span class:list={[s.text]} set:html={s.icon} />
  <div class:list={["[&>p]:mb-0 [&>p]:text-grey-1 text-grey-1", s.text]}>
    <slot />
  </div>
</div>
