---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";
import fs from "node:fs/promises";
import path from "node:path";
import sharp from "sharp";

type Props = {
  src: ImageMetadata;
  alt: string;
  class?: string;
  wrapperClass?: string;
  /** Eager-load + high priority. Use for above-the-fold heroes. */
  priority?: boolean;
} & Omit<HTMLAttributes<"img">, "src" | "alt" | "class">;

const {
  src,
  alt,
  class: className,
  wrapperClass,
  priority,
  ...rest
} = Astro.props;

// Map the imported ImageMetadata back to its source file on disk so we can
// generate a tiny blurred LQIP placeholder at build time (inlined as base64,
// so it paints instantly with no extra request).
const assetModules = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{png,jpg,jpeg,webp,avif,gif}",
  { eager: true },
);

// Cache so we only run sharp once per source image per build.
const lqipCache: Map<string, string> = ((globalThis as any).__lqipCache ??=
  new Map());

let lqip: string | undefined = lqipCache.get(src.src);

if (!lqip) {
  const entry = Object.entries(assetModules).find(
    ([, mod]) => mod.default.src === src.src,
  );

  if (entry) {
    try {
      const file = path.join(process.cwd(), entry[0]);
      const buffer = await fs.readFile(file);
      const out = await sharp(buffer)
        .resize(24, 24, { fit: "inside" })
        .webp({ quality: 40 })
        .toBuffer();
      lqip = `data:image/webp;base64,${out.toString("base64")}`;
      lqipCache.set(src.src, lqip);
    } catch {
      lqip = undefined;
    }
  }
}

const loadingProps = priority
  ? ({ loading: "eager", fetchpriority: "high", decoding: "sync" } as const)
  : {};
---

<div class:list={["relative block overflow-hidden", wrapperClass]}>
  <Image src={src} alt={alt} class={className} {...loadingProps} {...rest} data-blur-img />

  {
    lqip && (
      <img
        src={lqip}
        alt=""
        aria-hidden="true"
        data-blur-lqip
        class:list={[className]}
        style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:blur(20px);transform:scale(1.1);transition:opacity 700ms ease;pointer-events:none;will-change:opacity;"
      />
    )
  }
</div>

<script>
  function initBlur() {
    document
      .querySelectorAll<HTMLImageElement>("[data-blur-img]")
      .forEach((img) => {
        const lqip =
          img.parentElement?.querySelector<HTMLElement>("[data-blur-lqip]");
        if (!lqip || lqip.dataset.done) return;

        const hide = () => {
          lqip.dataset.done = "true";
          lqip.style.opacity = "0";
          setTimeout(() => lqip.remove(), 700);
        };

        if (img.complete && img.naturalWidth > 0) hide();
        else img.addEventListener("load", hide, { once: true });
      });
  }

  initBlur();
  document.addEventListener("astro:page-load", initBlur);
</script>
