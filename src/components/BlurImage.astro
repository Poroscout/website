---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";
import lqipMap from "../data/lqip.json";

type Props = {
  src: ImageMetadata;
  alt: string;
  class?: string;
  wrapperClass?: string;
  /** Eager-load + high priority. Use for above-the-fold heroes. */
  priority?: boolean;
} & Omit<HTMLAttributes<"img">, "src" | "alt" | "class">;

const {
  src,
  alt,
  class: className,
  wrapperClass,
  priority,
  ...rest
} = Astro.props;

// Map the imported ImageMetadata back to its source path so we can look up the
// blurred LQIP placeholder precomputed at build time (scripts/gen-lqip.mjs).
// Doing the lookup here, instead of running sharp inline, keeps this
// component renderable inside the on-demand Cloudflare worker, where native
// modules like sharp don't exist.
const assetModules = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{png,jpg,jpeg,webp,avif,gif}",
  { eager: true },
);

const sourcePath = Object.entries(assetModules).find(
  ([, mod]) => mod.default.src === src.src,
)?.[0];

const lqip: string | undefined = sourcePath
  ? (lqipMap as Record<string, string>)[sourcePath]
  : undefined;

const loadingProps = priority
  ? ({ loading: "eager", fetchpriority: "high", decoding: "sync" } as const)
  : {};
---

<div class:list={["relative block overflow-hidden", wrapperClass]}>
  <Image
    src={src}
    alt={alt}
    class={className}
    {...loadingProps}
    {...rest}
    data-blur-img
  />

  {
    lqip && (
      <img
        src={lqip}
        alt=""
        aria-hidden="true"
        data-blur-lqip
        class:list={[className]}
        style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:blur(20px);transform:scale(1.1);transition:opacity 700ms ease;pointer-events:none;will-change:opacity;"
      />
    )
  }
</div>

<script>
  function initBlur() {
    document
      .querySelectorAll<HTMLImageElement>("[data-blur-img]")
      .forEach((img) => {
        const lqip =
          img.parentElement?.querySelector<HTMLElement>("[data-blur-lqip]");
        if (!lqip || lqip.dataset.done) return;

        const hide = () => {
          lqip.dataset.done = "true";
          lqip.style.opacity = "0";
          setTimeout(() => lqip.remove(), 700);
        };

        if (img.complete && img.naturalWidth > 0) hide();
        else img.addEventListener("load", hide, { once: true });
      });
  }

  initBlur();
  document.addEventListener("astro:page-load", initBlur);
</script>
