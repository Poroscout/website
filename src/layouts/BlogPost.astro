---
import "../styles/post.css";

import type { CollectionEntry } from "astro:content";
import MainLayout from "./Main.astro";
import Hero from "../components/Hero.astro";
import HeroBackground from "../assets/lol.webp";

export interface Props {
  post: CollectionEntry<"blog">;
}

const props = Astro.props;
---

<MainLayout
  content={{
    title: props.post.data.title,
    description: props.post.data.description,
  }}
>
  <Hero image={HeroBackground} alt="League of Legends background" imageClass="opacity-50">
    <h1 class="text-5xl font-bold text-balance leading-[1.125] max-w-5xl">
      {props.post.data.title}
    </h1>
    <p class="text-lg text-gray-300 mt-2 font-medium">
      {props.post.data.description}
    </p>
    <p class="text-gray-400 text-md mt-1">
      {
        props.post.data.pubDate.toLocaleDateString("en-US", {
          month: "long",
          day: "numeric",
          year: "numeric",
        })
      }
    </p>
  </Hero>

  <main class="max-w-4xl mx-auto px-4 mt-10 pb-12">
    <article class="post text-primary">
      <slot />
    </article>
  </main>
</MainLayout>
