---
import MainLayout from "./Main.astro";
import Navbar from "../partials/Navbar.astro";
import GradientHeader from "../components/GradientHeader.astro";
import Background from "../assets/lol.webp";

export interface Props {
  title: string;
  description?: string;
  heading: string;
  lastUpdated: string; // ISO date, e.g. "2026-06-06"
}

const { title, description, heading, lastUpdated } = Astro.props;

const lastUpdatedLabel = new Date(lastUpdated).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<MainLayout content={{ title, description }}>
  <GradientHeader image={Background}>
    <header class="text-primary font-display max-w-5xl">
      <h1 class="text-5xl font-bold text-balance leading-[1.125]">
        {heading}
      </h1>
      <p class="text-lg text-gray-300 mt-2 font-medium">
        Last updated:
        <time datetime={lastUpdated}>{lastUpdatedLabel}</time>
      </p>
    </header>
  </GradientHeader>

  <Navbar forceBackground />

  <article class="legal mx-auto max-w-4xl px-4 mt-10 mb-24">
    <slot />
  </article>
</MainLayout>
