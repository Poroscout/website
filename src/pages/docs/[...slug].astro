---
import { getCollection, render, type CollectionEntry } from "astro:content";
import DocsLayout from "../../layouts/Docs.astro";
import Eyebrow from "../../components/Eyebrow.astro";

export async function getStaticPaths() {
  const entries = await getCollection("docs");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<"docs"> };
const { Content } = await render(entry);
const { title, description, category } = entry.data;
---

<DocsLayout title={title} description={description} activeSlug={entry.id}>
  <article class="max-w-3xl">
    <header>
      <Eyebrow>{category}</Eyebrow>
      <h1
        class="mt-3 mb-3 font-display text-4xl leading-tight text-gold-1 sm:text-5xl"
      >
        {title}
      </h1>
      <p class="text-lg text-grey-1">{description}</p>
    </header>

    <hr class="my-8 border-0 border-t border-gold-3/15" />

    <div class="docs-prose">
      <Content />
    </div>
  </article>
</DocsLayout>
