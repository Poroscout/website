---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Navbar from "../../partials/Navbar.astro";
import MainLayout from "../../layouts/Main.astro";

export async function getStaticPaths() {
  const posts = await getCollection("docs");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

const post = Astro.props as CollectionEntry<"docs">;
const { Content } = await render(post);
---

<MainLayout
  content={{
    title: `${post.data.title} • PoroScout Wiki`,
    description: post.data.description,
  }}
>
  <Navbar forceBackground />
  <div class="mb-16"></div>

  <div class="flex min-h-screen">
    <!-- Left Sidebar: Fixed to the left, full height below navbar, scrollable -->
    <aside
      class="fixed left-0 w-64 h-[calc(100vh-4rem)] p-4 overflow-y-auto z-40"
    >
      <nav>
        <ul class="space-y-2">
          <li>
            <a
              href="#"
              class="block py-2 px-3 rounded-lg hover:bg-gray-700 transition-colors duration-200"
              >Getting Started</a
            >
          </li>
          <!-- Collapsible menu for Commands -->
          <li>
            <button
              class="flex items-center justify-between w-full py-2 px-3 rounded-lg hover:bg-gray-700 text-left transition-colors duration-200"
              onclick="toggleMenu(this)"
            >
              <span>Commands</span>
              <!-- SVG icon for collapse/expand indication -->
              <svg
                class="w-4 h-4 transform transition-transform duration-200"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path></svg
              >
            </button>
            <ul class="pl-4 mt-2 space-y-1 hidden">
              <!-- Submenu, initially hidden -->
              <li>
                <a
                  href="#"
                  class="block py-1 px-2 rounded-lg hover:bg-gray-700 transition-colors duration-200"
                  >/commands/foo</a
                >
              </li>
              <li>
                <a
                  href="#"
                  class="block py-1 px-2 rounded-lg hover:bg-gray-700 transition-colors duration-200"
                  >/commands/bar</a
                >
              </li>
            </ul>
          </li>
          <!-- Collapsible menu for Concepts -->
          <li>
            <button
              class="flex items-center justify-between w-full py-2 px-3 rounded-lg hover:bg-gray-700 text-left transition-colors duration-200"
              onclick="toggleMenu(this)"
            >
              <span>Concepts</span>
              <svg
                class="w-4 h-4 transform transition-transform duration-200"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 9l-7 7-7-7"></path></svg
              >
            </button>
            <ul class="pl-4 mt-2 space-y-1 hidden">
              <li>
                <a
                  href="#"
                  class="block py-1 px-2 rounded-lg hover:bg-gray-700 transition-colors duration-200"
                  >Concept A</a
                >
              </li>
              <li>
                <a
                  href="#"
                  class="block py-1 px-2 rounded-lg hover:bg-gray-700 transition-colors duration-200"
                  >Concept B</a
                >
              </li>
            </ul>
          </li>
          <li>
            <a
              href="#"
              class="block py-2 px-3 rounded-lg hover:bg-gray-700 transition-colors duration-200"
              >API Reference</a
            >
          </li>
        </ul>
      </nav>
    </aside>

    <!-- Main Content Area: Takes up remaining space, with margins for fixed sidebars -->
    <main class="flex-1 ml-64 mr-64 p-8 overflow-y-auto">
      <h1 class="text-4xl font-bold mb-6 text-white">Welcome to the Docs!</h1>

      <section id="section1" class="mb-8">
        <h2 class="text-3xl font-semibold mb-4 text-gray-100">
          Section One: Introduction
        </h2>
        <p class="mb-4 leading-relaxed">
          This is the introductory section of our documentation. Here you will
          find an overview of the project and how to get started. Our goal is to
          provide clear and concise information to help you understand and
          utilize our services effectively.
        </p>
        <p class="mb-4 leading-relaxed">
          We believe in a user-friendly approach, ensuring that even complex
          topics are explained in an accessible manner. Feel free to explore the
          various sections using the navigation on the left.
        </p>
      </section>

      <section id="section2" class="mb-8">
        <h2 class="text-3xl font-semibold mb-4 text-gray-100">
          Section Two: Key Features
        </h2>
        <p class="mb-4 leading-relaxed">
          Here we highlight the core features that make our product stand out.
          From robust data handling to intuitive user interfaces, we've designed
          everything with your needs in mind. Each feature is detailed to give
          you a comprehensive understanding of its capabilities.
        </p>
        <ul class="list-disc list-inside mb-4 pl-4 space-y-1">
          <li>Feature A: Detailed description of its benefits and usage.</li>
          <li>Feature B: How it integrates with other parts of the system.</li>
          <li>Feature C: Advanced configurations and customization options.</li>
        </ul>
        <p class="mb-4 leading-relaxed">
          Our continuous development cycle ensures that new features are
          regularly added and existing ones are improved based on user feedback
          and technological advancements.
        </p>
      </section>

      <section id="section3" class="mb-8">
        <h2 class="text-3xl font-semibold mb-4 text-gray-100">
          Section Three: Advanced Usage
        </h2>
        <p class="mb-4 leading-relaxed">
          For power users and developers, this section delves into more advanced
          topics. Learn about custom integrations, API endpoints, and best
          practices for optimizing performance. We provide code examples and
          detailed explanations to guide you through complex implementations.
        </p>
        <pre
          class="bg-gray-800 p-4 rounded-lg text-sm overflow-x-auto mb-4 text-gray-200"><code>
function advancedFeatureExample(param
                  </code></pre>
        <p class="mb-4 leading-relaxed">
          Remember to consult the API reference for a complete list of available
          functions and their parameters. Our community forum is also a great
          place to ask questions and share your experiences.
        </p>
      </section>

      <section id="section4" class="mb-8">
        <h2 class="text-3xl font-semibold mb-4 text-gray-100">
          Section Four: Getting Help
        </h2>
        <p class="mb-4 leading-relaxed">
          If you encounter any issues or have questions, our support team is
          ready to assist you. You can reach out through our dedicated support
          portal, or by checking our FAQ section for common queries.
        </p>
        <ul class="list-disc list-inside mb-4 pl-4 space-y-1">
          <li>
            Visit our <a href="#" class="text-blue-400 hover:underline"
              >Support Portal</a
            >.
          </li>
          <li>
            Browse the <a href="#" class="text-blue-400 hover:underline"
              >FAQ Section</a
            >.
          </li>
          <li>
            Join our <a href="#" class="text-blue-400 hover:underline"
              >Community Forum</a
            >.
          </li>
        </ul>
        <p class="mb-4 leading-relaxed">
          We are committed to providing timely and effective support to ensure
          your experience with our product is smooth and productive.
        </p>
      </section>
    </main>

    <!-- Right Sidebar: Fixed to the right, full height below navbar, scrollable -->
    <aside
      class="fixed right-0 w-64 h-[calc(100vh-4rem)] p-4 overflow-y-auto shadow-inner z-40 rounded-tl-lg"
    >
      <h3 class="text-xl font-semibold mb-4 text-white">On this page</h3>
      <nav>
        <!-- This list will be populated dynamically by JavaScript -->
        <ul class="space-y-2 text-gray-300">
          <!-- Example placeholder item, will be replaced by JS -->
          <li>
            <a
              href="#section1"
              class="block hover:text-white py-1 px-2 rounded-lg transition-colors duration-200"
              >Section One: Introduction</a
            >
          </li>
          <li>
            <a
              href="#section2"
              class="block hover:text-white py-1 px-2 rounded-lg transition-colors duration-200"
              >Section Two: Key Features</a
            >
          </li>
          <li>
            <a
              href="#section3"
              class="block hover:text-white py-1 px-2 rounded-lg transition-colors duration-200"
              >Section Three: Advanced Usage</a
            >
          </li>
          <li>
            <a
              href="#section4"
              class="block hover:text-white py-1 px-2 rounded-lg transition-colors duration-200"
              >Section Four: Getting Help</a
            >
          </li>
        </ul>
      </nav>
    </aside>
  </div>

  <!-- Footer: Full width, dark background, centered text -->
  <footer class="w-full bg-gray-900 p-6 text-center text-gray-400 rounded-t-lg">
    <div class="container mx-auto">
      <p>&copy; 2025 Docs Site. All rights reserved.</p>
      <p class="mt-2">Built with Tailwind CSS.</p>
    </div>
  </footer>

  <script>
    /**
     * Toggles the visibility of a submenu and rotates an SVG icon.
     * This function is called when a collapsible menu button is clicked in the left sidebar.
     * @param {HTMLButtonElement} button - The button element that triggers the toggle.
     */
    function toggleMenu(button) {
      // Get the next sibling element, which is expected to be the submenu <ul>
      const submenu = button.nextElementSibling;
      // Get the SVG icon within the button (used for the expand/collapse arrow)
      const svg = button.querySelector("svg");

      // Toggle the 'hidden' class on the submenu to show or hide it
      submenu.classList.toggle("hidden");
      // Toggle the 'rotate-180' class on the SVG to animate its rotation (up/down arrow)
      svg.classList.toggle("rotate-180");
    }

    /**
     * Dynamically generates the table of contents for the right sidebar
     * based on h2 elements found in the main content area.
     * This ensures the "On this page" section is always up-to-date with the content.
     * This function runs once the DOM is fully loaded.
     */
    document.addEventListener("DOMContentLoaded", () => {
      const mainContent = document.querySelector("main");
      const rightSidebarNav = document.querySelector(
        "aside.fixed.right-0 nav ul",
      );

      // Ensure both main content and the right sidebar navigation element exist
      if (mainContent && rightSidebarNav) {
        // Clear any existing placeholder items in the right sidebar
        rightSidebarNav.innerHTML = "";

        // Find all h2 elements within the main content area
        const headings = mainContent.querySelectorAll("h2");

        // Iterate over each h2 heading to create a corresponding link in the TOC
        headings.forEach((heading) => {
          // If an h2 doesn't have an ID, generate a simple one from its text content
          if (!heading.id) {
            heading.id = heading.textContent
              .toLowerCase()
              .replace(/[^a-z0-9]+/g, "-") // Replace non-alphanumeric with hyphens
              .replace(/^-*|-*$/g, ""); // Trim leading/trailing hyphens
          }

          // Create a new list item (<li>) for the table of contents
          const listItem = document.createElement("li");
          // Create an anchor tag (<a>) for the link
          const link = document.createElement("a");
          link.href = `#${heading.id}`; // Set the href to the heading's ID
          link.textContent = heading.textContent; // Set the link text to the heading's text
          // Add Tailwind classes for styling and hover effects
          link.classList.add(
            "block",
            "hover:text-white",
            "py-1",
            "px-2",
            "rounded-lg",
            "transition-colors",
            "duration-200",
          );

          // Append the link to the list item, and the list item to the right sidebar nav
          listItem.appendChild(link);
          rightSidebarNav.appendChild(listItem);
        });
      }
    });
  </script>
</MainLayout>class
