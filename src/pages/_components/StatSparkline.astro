function generateSvgPath(data: number[], height = 100, width = 100) {
  const PADDING_BOTTOM = 5;

  const usableHeight = height - PADDING_BOTTOM;
  const interval = width / data.length;
  const dataMax = Math.max(...data);
  const dataMin = Math.min(...data);
  const ySlope = usableHeight / (dataMax - dataMin);

  // start at bottom left
  let path = `M 0,${height}`;

  // insert a point for each datapoint
  for (const [idx, count] of data.entries()) {
    const x = interval * idx;
    const y = usableHeight - ySlope * (count - dataMin);

    path += ` L ${x.toFixed(2)},${y.toFixed(2)}`;
  }

  // close the shape
  path += ` L ${width},${height} L 0,${height}`;

  return path;
}
