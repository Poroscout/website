---
import { Icon } from "astro-icon/components";
import { getBotStats } from "../../data/stats";

const stats = await getBotStats(Astro.locals);
const formatNumber = (num: number) => Intl.NumberFormat().format(num);
const metrics = [
  {
    icon: "lucide:server",
    value: Math.max(stats.guildCount.current, stats.guildCount.discordEstimate),
    label: "Discord Servers",
    description: "Active communities using our bot",
  },
  {
    icon: "lucide:users",
    value: stats.userCount.current,
    label: "Total Users",
    description: "Members across all servers",
  },
  {
    icon: "lucide:zap",
    value: stats.interactionCount.current,
    label: "Commands Weekly",
    description: "Bot interactions per week",
  },
];
---

<section class="relative z-10 px-6 sm:px-8 py-14 md:py-16" aria-labelledby="community-title">
  <div class="mx-auto max-w-6xl">
    <div class="text-center mb-10">
      <h2 id="community-title" class="text-3xl md:text-4xl font-bold mb-3 font-display text-gold-1 text-balance">
        Trusted by Communities Worldwide
      </h2>
      <p class="text-grey-1 text-sm leading-relaxed max-w-2xl mx-auto">
        Join thousands of Discord servers already using our bot to enhance
        their community experience
      </p>
    </div>

    <dl class="grid grid-cols-1 sm:grid-cols-3 border-y border-gold-2/20 py-2 sm:py-7">
      {
        metrics.map((metric, index) => (
          <div class:list={[
            "flex flex-col items-center px-4 py-5 text-center",
            index > 0 && "border-t sm:border-t-0 sm:border-l border-gold-2/20",
          ]}>
            <dt class="flex items-center gap-2 font-subhead text-xs text-gold-1">
              <Icon name={metric.icon} size={16} class="text-gold-2" aria-hidden="true" />
              {metric.label}
            </dt>
            <dd class="mt-3 font-display font-bold tabular-nums text-4xl md:text-5xl text-gold-2">
              {formatNumber(metric.value)}
            </dd>
            <dd class="mt-2 text-xs leading-relaxed text-grey-1">{metric.description}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
