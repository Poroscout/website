---
import { Icon } from "astro-icon/components";
import StatSparkline from "./StatSparkline.astro";
---

<div class="relative">
  <div class="inset-0 pt-5 absolute -z-10 fill-[#5c7bea]">
    <StatSparkline />
  </div>

  <section class="py-16 px-4 md:px-6">
    <div class="container mx-auto max-w-6xl">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4 font-display">
          Trusted by Communities Worldwide
        </h2>
        <p class="text-gray-400 text-lg max-w-2xl mx-auto">
          Join thousands of Discord servers already using our bot to enhance
          their community experience
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {/* Servers */}
        <div class="text-center group">
          <div
            class="bg-gray-900 rounded-2xl p-8 border border-gray-800 hover:border-purple-500 transition-colors duration-300 relative"
          >
            <div
              class="inline-flex items-center justify-center w-16 h-16 bg-purple-600 rounded-full mb-6 group-hover:bg-purple-500 transition-colors duration-300"
            >
              <Icon name="lucide:server" size={32} />
            </div>
            <div class="text-4xl md:text-5xl font-bold text-purple-400 mb-2">
              5,000+
            </div>
            <div class="text-gray-300 text-lg font-medium">Discord Servers</div>
            <div class="text-gray-500 text-sm mt-2">
              Active communities using our bot
            </div>
          </div>
        </div>

        {/* Users */}
        <div class="text-center group">
          <div
            class="bg-gray-900 rounded-2xl p-8 border border-gray-800 hover:border-blue-500 transition-colors duration-300"
          >
            <div
              class="inline-flex items-center justify-center w-16 h-16 bg-blue-600 rounded-full mb-6 group-hover:bg-blue-500 transition-colors duration-300"
            >
              <Icon name="lucide:users" size={32} />
            </div>
            <div class="text-4xl md:text-5xl font-bold text-blue-400 mb-2">
              800K+
            </div>
            <div class="text-gray-300 text-lg font-medium">Total Users</div>
            <div class="text-gray-500 text-sm mt-2">
              Members across all servers
            </div>
          </div>
        </div>

        {/* Commands */}
        <div class="text-center group">
          <div
            class="bg-gray-900 rounded-2xl p-8 border border-gray-800 hover:border-green-500 transition-colors duration-300"
          >
            <div
              class="inline-flex items-center justify-center w-16 h-16 bg-green-600 rounded-full mb-6 group-hover:bg-green-500 transition-colors duration-300"
            >
              <Icon name="lucide:zap" size={32} />
            </div>
            <div class="text-4xl md:text-5xl font-bold text-green-400 mb-2">
              1
            </div>
            <div class="text-gray-300 text-lg font-medium">Commands Weekly</div>
            <div class="text-gray-500 text-sm mt-2">
              Bot interactions per week
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
