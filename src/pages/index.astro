---
// On-demand rendered so the ISR middleware can cache it in KV and revalidate
// the bot stats hourly. Every other route stays prerendered (static CDN).
export const prerender = false;

import "../styles/global.css";

import MainLayout from "../layouts/Main.astro";
import BlurImage from "../components/BlurImage.astro";
import Navbar from "../partials/Navbar.astro";
import { getCollection } from "astro:content";
import ImageCard from "../components/ImageCard.astro";
import Statistics from "./_components/Statistics.astro";
import FeatureRow from "../components/FeatureRow.astro";
import Divider from "../components/Divider.astro";
import Button from "../components/Button.astro";
import CTA from "../components/CTA.astro";
import ScoutingBackdrop from "../components/ScoutingBackdrop.astro";

import HeroBackground from "../assets/piltover-wall.png";
import PoroReading from "../assets/poro-read.jpg";

import FeatureChampions from "../assets/features/champions.webp";
import FeatureGraphs from "../assets/features/graphs.webp";
import FeatureMatch from "../assets/features/match.webp";
import FeaturePatchnotes from "../assets/features/patchnotes.webp";
import FeatureProfile from "../assets/features/profile.webp";

const latestBlog = await getCollection("blog").then(
  (post) =>
    post.sort(
      (a, b) =>
        new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
    )[0],
);
---

<MainLayout
  content={{
    title: "Welcome to PoroScout",
  }}
>
  <!-- Hero -->
  <section class="home-hero relative isolate flex flex-col">
    <BlurImage
      src={HeroBackground}
      alt=""
      height={1900}
      priority
      wrapperClass="absolute inset-0 -z-20"
      class="w-full h-full object-cover"
    />

    <!-- fade to black -->
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-b from-void-0/35 via-void-0/20 to-gray-950"
    >
    </div>

    <Navbar class="z-50" />

    <div
      class="hero-copy max-w-6xl w-full mx-auto text-primary font-display px-6 sm:px-8 flex grow flex-col justify-center"
    >
      <p
        class="mb-4 font-subhead text-xs font-semibold uppercase text-gold-2 tracking-[0.16em]"
      >
        Piltover's Finest
      </p>
      <h1
        class="hero-title font-bold mb-5 text-gold-1 leading-[1.04] tracking-[-0.02em]"
      >
        League of Legends
        <br />Discord Bot
      </h1>
      <p class="mb-8 max-w-xl font-body text-sm sm:text-base leading-relaxed text-gold-1/85">
        Your ultimate chat companion for tracking player statistics, champion
        builds, and more!
      </p>
      <div
        class="flex flex-col sm:flex-row gap-3 items-start sm:items-center"
      >
        <Button href="/invite">
          <span aria-hidden="true">＋</span> Add to a Server
        </Button>
        <Button href="/invite-user" variant="ghost">
          Add to Your Account
        </Button>
      </div>
    </div>

    <!-- latest blog -->
    <section
      aria-label="News and documentation"
      class="max-w-6xl mx-auto w-full px-6 sm:px-8 pb-10 md:pb-12"
    >
      <div
        class="grid gap-3 sm:grid-cols-2 md:ml-auto md:max-w-[680px]"
      >
        <ImageCard
          class="hero-card"
          image={latestBlog.data.cover}
          title={latestBlog.data.title}
          subtitle={latestBlog.data.description}
          tooltip={latestBlog.data.pubDate.toLocaleDateString("en-US", {
            month: "long",
            day: "numeric",
            year: "numeric",
          })}
        >
          <a
            href={`/post/${latestBlog.data.slug ?? latestBlog.id}`}
            class="absolute inset-0"
            aria-label={`Read ${latestBlog.data.title}`}
            data-astro-prefetch></a>
        </ImageCard>

        <ImageCard
          class="hero-card"
          image={PoroReading}
          title="Wiki"
          subtitle="Check out all of PoroScout's features and commands in our wiki!"
        >
          <a href="/docs" class="absolute inset-0" aria-label="Explore the PoroScout wiki" data-astro-prefetch></a>
        </ImageCard>
      </div>
    </section>
  </section>

  <div class="relative isolate overflow-clip">
    <ScoutingBackdrop />
    <Statistics />

  <section class="home-features relative bg-hex-blue-deep">
    <div class="relative z-10 mx-auto max-w-6xl px-6 sm:px-8">

      <FeatureRow
        id="champion"
        commands={["/champion", "/counters", "/synergies"]}
        eyebrow="Partnered with Mobalytics.gg"
        title="Scout Champion Data"
        body="Accurate, up-to-date data for any champion in the game, straight from Mobalytics.gg. Lock in the optimal setup before you ever hit the queue."
        bullets={[
          "Champion build & runes",
          "Abilities & skill order",
          "Win rates, pick rates & ban rates",
          "Counters & synergies",
        ]}
        image={FeatureChampions}
        imageAlt="PoroScout /champion command showing a build, runes and stats"
        wikiSlug="commands/champion"
      />

      <Divider />

      <FeatureRow
        commands={["/graph lp"]}
        eyebrow="Tracked hourly"
        title="Scout Historical Data"
        body="PoroScout tracks your rank, LP, wins, and losses. View your progression interactively and share your journey with friends."
        bullets={[
          "Track Soloq and Flex",
          "Win / loss history",
          "Per-match resolution",
          // "Your position on the normal distribution curve",
        ]}
        image={FeatureGraphs}
        imageAlt="PoroScout /graph and /mmr commands showing MMR and LP graphs"
        reverse
        wikiSlug="commands/graph-lp"
      />

      <Divider />

      <FeatureRow
        commands={["/matches"]}
        eyebrow="Scout match details"
        title="Break down recent games"
        body="Look up a summoner's recent games and read the whole story of each match: comps, bans, and per-player performance at a glance."
        bullets={[
          "Full team composition & banned champions",
          "Player KDAs and CS",
          "Gold difference vs. your lane opponent",
          "Damage dealt, taken & shielded",
        ]}
        image={FeatureMatch}
        imageAlt="PoroScout /matches command showing a detailed match breakdown"
        wikiSlug="commands/matches"
      />

      <Divider />

      <FeatureRow
        commands={["/profile", "/mastery"]}
        eyebrow="Scout summoner profiles"
        title="Know any summoner"
        body="Pull a complete profile for any summoner, or surface their most-played champions with a single command."
        bullets={[
          "Summoner level & ranked Solo/Duo + Flex stats",
          "Top champions",
          "Recent & live games",
          "/mastery - top 10 mastered champions",
        ]}
        image={FeatureProfile}
        imageAlt="PoroScout /profile command showing a summoner profile"
        reverse
        wikiSlug="commands/profile"
      />

      <Divider />

      <FeatureRow
        commands={["/patchnotes", "/configure"]}
        eyebrow="Scout patch notes"
        title="Never miss a patch"
        body="Get the details on the latest League patch on demand or set a channel with /configure patchnotes to have PoroScout post updates automatically on patch day."
        bullets={[
          "Latest patch notes via /patchnotes",
          "Auto-delivery to a channel of your choice",
          "Posted the moment a patch drops",
        ]}
        image={FeaturePatchnotes}
        imageAlt="PoroScout posting the latest League patch notes"
        wikiSlug="commands/patchnotes"
      />
    </div>
  </section>
  </div>

  <CTA />
</MainLayout>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const visuals = document.querySelectorAll<HTMLElement>("[data-feature-visual]");
  const backdrop = document.querySelector<HTMLElement>("[data-scouting-backdrop]");
  const lines = document.querySelector<HTMLElement>("[data-scouting-lines]");
  const revealed = new WeakSet<HTMLElement>();
  const revealThreshold = 0.25;
  const revealTopInset = 80;
  const revealBottomInset = 120;
  let backdropVisible = false;
  let frame = 0;

  function reveal(visual: HTMLElement): boolean {
    if (revealed.has(visual)) return true;
    if (reducedMotion.matches) return false;
    const bounds = visual.getBoundingClientRect();
    const visibleHeight = Math.min(bounds.bottom, window.innerHeight - revealBottomInset)
      - Math.max(bounds.top, revealTopInset);
    // Check again after image loading, since the visitor may have scrolled away.
    if (bounds.height <= 0 || visibleHeight / bounds.height < revealThreshold) return false;

    revealed.add(visual);
    // Animate the artwork inside the stable observer target.
    visual.dataset.revealState = "revealed";
    return true;
  }

  const revealObserver = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting || entry.intersectionRatio < revealThreshold) continue;
        const visual = entry.target as HTMLElement;
        const image = visual.querySelector("img");
        if (!image || image.complete) {
          if (reveal(visual)) revealObserver.unobserve(visual);
        } else {
          revealObserver.unobserve(visual);
          image.addEventListener("load", () => {
            if (!reveal(visual) && !reducedMotion.matches) {
              revealObserver.observe(visual);
            }
          }, { once: true });
        }
      }
    },
    {
      threshold: revealThreshold,
      rootMargin: `-${revealTopInset}px 0px -${revealBottomInset}px 0px`,
    },
  );

  function updateDrift() {
    frame = 0;
    if (!backdrop || !lines) return;
    const bounds = backdrop.getBoundingClientRect();
    const progress = Math.max(0, Math.min(1,
      (window.innerHeight - bounds.top) / (window.innerHeight + bounds.height),
    ));
    lines.style.setProperty("--scout-drift", `${((progress - 0.5) * 24).toFixed(2)}px`);
  }

  function requestDrift() {
    if (!frame && backdropVisible && !reducedMotion.matches && !document.hidden) {
      frame = requestAnimationFrame(updateDrift);
    }
  }

  const backdropObserver = new IntersectionObserver(([entry]) => {
    backdropVisible = entry.isIntersecting;
    requestDrift();
  });
  if (backdrop) backdropObserver.observe(backdrop);

  function updateMotionPreference() {
    revealObserver.disconnect();
    if (reducedMotion.matches) {
      cancelAnimationFrame(frame);
      frame = 0;
      visuals.forEach((visual) => delete visual.dataset.revealState);
      lines?.style.removeProperty("--scout-drift");
    } else {
      visuals.forEach((visual) => {
        if (revealed.has(visual)) return;
        // Never hide artwork that the visitor can already see, including
        // restored scroll positions and direct links to a feature.
        if (visual.getBoundingClientRect().top < window.innerHeight) {
          revealed.add(visual);
          return;
        }
        visual.dataset.revealState = "pending";
        revealObserver.observe(visual);
      });
      requestDrift();
    }
  }

  window.addEventListener("scroll", requestDrift, { passive: true });
  window.addEventListener("resize", requestDrift, { passive: true });
  document.addEventListener("visibilitychange", requestDrift);
  reducedMotion.addEventListener("change", updateMotionPreference);
  updateMotionPreference();
</script>

<style>
  .home-features {
    background-image: linear-gradient(
      to bottom,
      var(--color-gray-950),
      var(--color-hex-blue-deep) clamp(16rem, 24vw, 24rem)
    );
  }

  .home-hero {
    min-height: max(48rem, 100svh);
    padding-top: 5rem;
  }

  .hero-copy {
    padding-block: 5rem 3rem;
  }

  .hero-title {
    font-size: clamp(2.75rem, 5.5vw, 4.75rem);
  }

  .home-hero :global(.hero-card) {
    height: 11rem;
    max-width: none;
  }

  .home-hero :global(.hero-card h2) {
    font-size: 1.5rem;
  }

  .home-hero :global(.hero-card p) {
    font-size: 0.75rem;
    line-height: 1.6;
  }

  @media (max-width: 639px) {
    .home-hero {
      min-height: 100svh;
    }

    .hero-copy {
      padding-block: 4rem;
    }

    .home-hero :global(.hero-card) {
      height: 7rem;
    }

    .home-hero :global(.hero-card p) {
      display: none;
    }
  }
</style>
